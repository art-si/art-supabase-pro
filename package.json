    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "decimal.js-light": "2.5.1",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "exceljs": "4.4.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "1.11.13",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "monaco-editor": "0.57.0",
    "monaco-sql-languages": "^1.2.1",
