{
  "name": "art-supabase-pro",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "types": "./src/types/platform-runtime.d.ts",
  "files": [
    ".auto-import.json",
    ".env",
    ".env.development",
    ".env.production",
    "src",
    "public",
    "scripts/ui-audit.ts",
    "scripts/generate-offline-icons.ts",
    "scripts/module-vite-config.mjs",
    "scripts/module-vite-config.d.mts",
    "scripts/hosted-module-dependencies.mjs",
    "scripts/hosted-module-dependencies.d.mts",
    "scripts/element-plus-style-chunks.mjs",
    "scripts/element-plus-style-chunks.d.mts",
    "scripts/vite-watch-policy.mjs",
    "scripts/vite-watch-policy.d.mts",
    "scripts/scss-globals.mjs",
    "scripts/scss-globals.d.mts",
    "scripts/build-log-policy.mjs",
    "scripts/build-log-policy.d.mts",
    "scripts/module-typecheck.mjs",
    "scripts/module-typecheck.d.mts"
  ],
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.28.2"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:cloudbase": "vite --open --mode cloudbase",
    "build": "pnpm icons:check && vite build",
    "cloudbase:install": "sh scripts/cloudbase-install.sh",
    "cloudbase:build": "VITE_OUT_DIR=cloudbase-dist VITE_BASE_URL=/art-supabase-pro/ VITE_HOSTED_APPLICATION_BASE_URL=/art-supabase-pro/ RAYON_NUM_THREADS=2 UV_THREADPOOL_SIZE=2 NODE_OPTIONS=--max-old-space-size=3072 npx --yes pnpm@11.28.2 build --mode cloudbase",
    "build:all": "pnpm modules:build && pnpm build",
    "modules": "tsx scripts/manage-modules.ts",
    "modules:status": "tsx scripts/manage-modules.ts status",
    "modules:pull": "tsx scripts/manage-modules.ts pull",
    "modules:update": "tsx scripts/manage-modules.ts update",
    "modules:install": "tsx scripts/manage-modules.ts install",
    "modules:check": "tsx scripts/manage-modules.ts check",
    "modules:build": "tsx scripts/manage-modules.ts build",
    "modules:setup": "tsx scripts/manage-modules.ts setup",
    "repo:pull": "tsx scripts/repository-workflow.ts pull",
    "repo:publish": "tsx scripts/repository-workflow.ts publish",
    "build:analyze": "tsx scripts/analyze-build.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "database:security:audit": "tsx scripts/audit-database-security.ts",
    "permissions:audit": "tsx scripts/audit-business-permissions.ts",
    "reuse:audit": "tsx scripts/audit-shared-reuse.ts",
    "snapshot:ai": "tsx scripts/generate-ai-project-snapshot.ts",
    "snapshot:check": "tsx scripts/generate-ai-project-snapshot.ts --check",
    "icons:generate": "tsx scripts/generate-offline-icons.ts",
    "icons:check": "tsx scripts/generate-offline-icons.ts --check",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "serve": "tsx scripts/serve-built-app.ts",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx,vue}\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"modules/*/src/**/*.{js,mjs,cjs,ts,tsx,vue}\" \"modules/*/scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"modules/*/tests/**/*.{js,mjs,cjs,ts,tsx}\" \"modules/*/vite.config.ts\" \"*.{js,mjs,cjs,ts}\"",
    "typecheck": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js --noEmit --pretty false",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('.artifacts/coverage',{recursive:true})\" && tsx --test --test-concurrency=1 --experimental-test-coverage --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=.artifacts/coverage/lcov.info \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-include=supabase/functions/_shared/*.ts\" \"--test-coverage-include=scripts/*.ts\" --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=80 tests/unit/*.test.ts",
    "test:db": "supabase db query --linked --file tests/integration/database-security-policy.sql",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth-pages.accessibility.spec.ts --project=public-desktop-1440 --project=public-mobile-390",
    "test:e2e:critical": "playwright test tests/e2e/ai-configuration-inheritance.smoke.spec.ts tests/e2e/dictionary-bootstrap.spec.ts --project=desktop-1440",
    "test:e2e:core": "playwright test tests/e2e/core-pages.visual.spec.ts tests/e2e/finance-expense-tree.spec.ts --project=desktop-1440 --project=mobile-390",
    "test:e2e:states": "playwright test tests/e2e/smis-training-list-state.spec.ts tests/e2e/smis-qualification-list-state.spec.ts tests/e2e/smis-report-state.spec.ts tests/e2e/smis-risk-list-state.spec.ts tests/e2e/smis-hazardous-waste-list-retry.spec.ts tests/e2e/smis-inspection-category-options.spec.ts --project=desktop-1440 --project=mobile-390 --no-deps",
    "test:e2e:exports": "playwright test \"tests/e2e/.*-export\\.spec\\.ts\" tests/e2e/document-center.visual.spec.ts --project=desktop-1440 --project=mobile-390",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "check:fast": "pnpm icons:check && pnpm ui:audit && pnpm reuse:audit && pnpm dependencies:audit && pnpm permissions:audit && pnpm database:security:audit && pnpm typecheck && pnpm lint && pnpm test:unit",
    "check": "pnpm check:fast && pnpm lint:stylelint",
    "check:ci": "pnpm icons:check && pnpm ui:audit && pnpm reuse:audit && pnpm dependencies:audit && pnpm permissions:audit && pnpm database:security:audit && pnpm typecheck && pnpm lint && pnpm lint:stylelint && pnpm test:coverage && pnpm snapshot:check && pnpm build && pnpm bundle:check && pnpm test:e2e:auth && pnpm test:e2e:critical && pnpm test:e2e:core && pnpm test:e2e:states && pnpm test:e2e:exports",
    "fix": "pnpm lint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss,vue}\" \"modules/*/src/**/*.{css,scss,vue}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" \"modules/*/src/**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "git-hooks:install": "husky",
    "commit": "git-cz",
    "dependencies:audit": "tsx scripts/audit-module-dependencies.ts",
    "dependencies:sync-patches": "tsx scripts/audit-module-dependencies.ts --sync-patches"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.10.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@file-viewer/preset-all": "3.1.2",
